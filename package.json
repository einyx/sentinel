{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Secret scanning for the organisation's repositories",
  "license": "AGPL-3.0-or-later OR LicenseRef-Proprietary",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace @sentinel/core && npm run build --workspace @sentinel/api && npm run build --workspace @sentinel/console",
    "build:core": "npm run build --workspace @sentinel/core",
    "build:api": "npm run build --workspace @sentinel/api",
    "build:console": "npm run build --workspace @sentinel/console",
    "dev:api": "npm run dev --workspace @sentinel/api",
    "dev:console": "npm run dev --workspace @sentinel/console",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
